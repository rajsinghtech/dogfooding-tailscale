vars:
  region: us-west-2
  tenant: my
  environment: aws-uw2
  stage: test

import:
  - catalog/aws-eks

components:
  terraform:
    aws-eks:
      vars:
        cluster_name: "cluster2"
        public_workers: false
        sr_instance_hostname: "my-cluster2-aws-uw2-sr"
        cluster_endpoint_public_access: false
        cluster_endpoint_private_access: true
        vpc_cidr: "10.1.0.0/16"
        cluster_service_ipv4_cidr: "10.41.0.0/16"
        advertise_routes: ["10.1.0.0/16"]
        tailscale_track: "unstable"
        tailscale_peer_relay_port: 45641
    aws-k8s-setup:
      vars:
        flux_cluster_path: "clusters/cluster2/flux"
        sops_gpg_private_key_file: "/secure/path/flux-sops-private-key.asc"
      dependencies:
        components:
          - name: aws-eks