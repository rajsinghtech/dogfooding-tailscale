name: Workflows for the peer relay + Global Accelerator test
description: Apply each relay_mode in turn and measure client A -> client B. Example stack my-aws-ue1-prga.

workflows:
  validate-all:
    steps:
      - command: terraform validate aws-peer-relay-ga -s my-aws-ue1-prga

  plan:
    steps:
      - command: terraform plan aws-peer-relay-ga -s my-aws-ue1-prga

  test-all:
    description: |
      DERP baseline, then 5 rounds of relay-public-IP vs Global Accelerator. Each round applies
      the matching relay_mode, so only one path to the relay exists at a time (GA and direct
      traffic from the same client ip:port to one endpoint collide in AWS).
      Results land in ./work/peer-relay-ga/<label>/summary.txt and transcript.txt
    steps:
      - command: terraform apply aws-peer-relay-ga -s my-aws-ue1-prga -- -auto-approve -var relay_mode=none
      - type: shell
        command: components/terraform/aws-peer-relay-ga/files/measure.sh my-aws-ue1-prga none work/peer-relay-ga
      - type: shell
        command: for i in 1 2 3 4 5; do for p in public ga; do atmos terraform apply aws-peer-relay-ga -s my-aws-ue1-prga -- -auto-approve -var relay_mode=$p && components/terraform/aws-peer-relay-ga/files/measure.sh my-aws-ue1-prga "$p-$i" work/peer-relay-ga "$p" || exit 1; done; done

  destroy:
    steps:
      - command: terraform destroy aws-peer-relay-ga -s my-aws-ue1-prga -- -auto-approve
