name: Workflows for Tailscale-GKE-Autopilot
description: Atmos workflows for managing Tailscale-GKE-Autopilot
# Example stack: my-gke-gce-uc1-test (from stacks/deploy/*.yaml.example). Add a step per stack you deploy.

workflows:
  validate-all:
    description: |
      Run 'terraform validate' on every component
    steps:
      - command: terraform validate google-gke-autopilot -s my-gke-gce-uc1-test

  plan-all:
    description: |
      Run 'terraform plan' on every component (later phases need earlier phases applied)
    steps:
      - command: terraform plan google-gke-autopilot -s my-gke-gce-uc1-test

  apply-all:
    description: |
      Run 'terraform apply' on every component in order
    steps:
      - command: terraform apply google-gke-autopilot -auto-approve -s my-gke-gce-uc1-test

  destroy-all:
    description: |
      Run 'terraform destroy' on every component in reverse order
    steps:
      - command: terraform destroy google-gke-autopilot -auto-approve -s my-gke-gce-uc1-test

  clean-all:
    description: |
      Run 'terraform clean' on every component
    steps:
      - command: terraform clean google-gke-autopilot --force -s my-gke-gce-uc1-test
