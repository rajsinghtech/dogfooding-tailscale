name: Workflows for Tailscale-AKS
description: Atmos workflows for managing Tailscale-AKS
# Example stack: my-az-ue1-test (from stacks/deploy/*.yaml.example). Add a step per stack you deploy.

workflows:
  validate-phase1:
    description: |
      Run 'terraform validate' on azure-aks
    steps:
      - command: terraform validate azure-aks -s my-az-ue1-test

  plan-phase1:
    description: |
      Run 'terraform plan' on azure-aks
    steps:
      - command: terraform plan azure-aks -s my-az-ue1-test

  apply-phase1:
    description: |
      Run 'terraform apply' on azure-aks
    steps:
      - command: terraform apply azure-aks -auto-approve -s my-az-ue1-test

  validate-phase2:
    description: |
      Run 'terraform validate' on azure-k8s-setup
    steps:
      - command: terraform validate azure-k8s-setup -s my-az-ue1-test

  plan-phase2:
    description: |
      Run 'terraform plan' on azure-k8s-setup
    steps:
      - command: terraform plan azure-k8s-setup -s my-az-ue1-test

  apply-phase2:
    description: |
      Run 'terraform apply' on azure-k8s-setup
    steps:
      - command: terraform apply azure-k8s-setup -auto-approve -s my-az-ue1-test

  validate-all:
    description: |
      Run 'terraform validate' on every component
    steps:
      - command: terraform validate azure-aks -s my-az-ue1-test
      - command: terraform validate azure-k8s-setup -s my-az-ue1-test

  plan-all:
    description: |
      Run 'terraform plan' on every component (later phases need earlier phases applied)
    steps:
      - command: terraform plan azure-aks -s my-az-ue1-test
      - command: terraform plan azure-k8s-setup -s my-az-ue1-test

  apply-all:
    description: |
      Run 'terraform apply' on every component in order
    steps:
      - command: terraform apply azure-aks -auto-approve -s my-az-ue1-test
      - command: terraform apply azure-k8s-setup -auto-approve -s my-az-ue1-test

  destroy-all:
    description: |
      Run 'terraform destroy' on every component in reverse order
    steps:
      - command: terraform destroy azure-k8s-setup -auto-approve -s my-az-ue1-test
      - command: terraform destroy azure-aks -auto-approve -s my-az-ue1-test

  clean-all:
    description: |
      Run 'terraform clean' on every component
    steps:
      - command: terraform clean azure-k8s-setup --force -s my-az-ue1-test
      - command: terraform clean azure-aks --force -s my-az-ue1-test
